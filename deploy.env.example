# 部署环境变量模板：复制为与 docker-compose.yml 同目录的 .env 后填写。
#   cp deploy.env.example .env
# docker compose 会自动读取该文件。地址类变量在容器启动时生效，
# 修改后执行 docker compose up -d 即可，无需重新构建镜像。

# 必填：看板指标后端地址；只填协议、IP 和端口，不追加 /api。
# 通常与本地 .env.local 的 BACKEND_URL 相同（若服务器与后端网络互通）。
BACKEND_URL=http://<BACKEND_IP>:<BACKEND_PORT>

# 可选：Benchmark 独立部署时填写其地址；留空则回放请求也走 BACKEND_URL。
REPLAY_BACKEND_URL=

# 可选：回放接口前缀；须与前端构建使用的回放路径前缀一致，默认 /api/replays。
# 注意：自定义回放路径（VITE_REPLAY_*_PATH）在构建时注入产物，
# 改动须 docker compose up -d --build 重建，且六条回放路径须共享同一前缀。
REPLAY_PATH_PREFIX=/api/replays

# 可选：manual（默认，页面输入认证值）或 proxy（同源代理注入密钥，认证自动恢复）。
# 修改此值需要 --build 重建镜像：前端产物在构建时固化该模式。
VITE_REPLAY_AUTH_MODE=manual

# 仅 proxy 模式需要：与 Benchmark 服务一致的原始密钥，不加 Bearer。
# 密钥存在于容器环境变量中（docker inspect 可见），服务器必须具备访问控制，
# 不能把携带服务密钥的代理公开成无认证接口。
BENCHMARK_API_KEY=

# 看板对外端口（宿主机端口），默认 8080。
DASHBOARD_PORT=8080
