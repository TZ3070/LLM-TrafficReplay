# 此模板由容器启动脚本 docker/nginx/15-generate-default-conf.sh 经 envsubst 生成到
# /etc/nginx/conf.d/default.conf。仅替换明确列出的占位符；
# nginx 运行时变量（$uri、$host 等）由显式变量列表保护，保持原样。
# 语义对齐 vite.config.mjs 的 createBackendProxy：无路径改写、回放路径优先分流、
# proxy 认证模式仅对回放路由注入 Bearer 密钥。

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # 端口映射部署时避免目录重定向泄漏容器内部端口。
    absolute_redirect off;

    gzip on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # 内容寻址的构建产物文件名含哈希，可永久缓存。
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # 入口页禁缓存，发版后浏览器立即取到新 bundle 引用。
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # 灰度指标直连 Prometheus；由启动脚本生成两个精确路由或明确的 503。
    ${REPLAY_PROMETHEUS_LOCATIONS}

    # Benchmark's available LiteLLM targets share the replay backend.
    location = /api/models {
        proxy_pass ${REPLAY_BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 回放路由：正则 location 优先于前缀 location，实现"回放优先于 /api"；
    # 回放路径前缀已转义元字符，边界 (?:$|/) 对齐 Vite 代理的 ^/api/replays(?:$|[/?])。
    # 下方认证指令行由 proxy 认证模式注入（Bearer 密钥），manual 模式下为空。
    location ~ ^${REPLAY_PATH_REGEX}(?:$|/) {
        # proxy_pass 不带 URI 部分：后端收到完整原始路径（Vite 代理无 rewrite 的等价物）。
        proxy_pass ${REPLAY_BACKEND_URL};
        proxy_http_version 1.1;
        ${AUTH_DIRECTIVE}
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 指标后端：同上，路径原样透传。
    location /api {
        proxy_pass ${BACKEND_URL};
        proxy_read_timeout 310s;
        proxy_send_timeout 310s;
        proxy_http_version 1.1;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /health {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
    }

    # SPA fallback：任意前端路由均返回 index.html。
    location / {
        try_files $uri $uri/ /index.html;
    }
}
