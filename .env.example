# 复制为 .env.local，替换为现有看板后端地址，然后重启开发服务。
# 此地址供 Vite 代理使用；浏览器仍请求 /api，相应生产代理需在静态服务器配置。
# 通常只填协议、IP 和端口，不追加 /api，也不填写 Prometheus/vLLM 地址。
BACKEND_URL=http://<BACKEND_IP>:<BACKEND_PORT>
# 可选：Benchmark 独立部署时填写其地址；留空则回放仍走 BACKEND_URL。
# /api/replays 及其子路径（或自定义回放路径）分流到此地址，指标仍走上述后端。
# 不在此填写密钥；页面选择 Authorization 并输入 Bearer 空格加 BENCHMARK_API_KEY 的实际值。
REPLAY_BACKEND_URL=
# 若与旧看板同机，旧代理 target 是 http://localhost:3000，可先使用完全相同的值。
# 可选联调日志：Vite 终端显示目标和上游状态，不输出查询串或认证值。
BACKEND_PROXY_DEBUG=false
# 已确认的真实后端路由为 /api/prometheus。
# VITE_ 变量在构建时生效，修改后重新执行 npm run dev（包含构建）。
VITE_PROMETHEUS_API_PREFIX=/api/prometheus
# 仅保留旧配置兼容；首页模型下拉框已通过上述 Prometheus query 获取，不调用该路径。
VITE_MODEL_INFO_PATH=/api/litellm/model/info
# 模型下拉框直接使用 Prometheus model_name；若回放后端需要 LiteLLM 别名，配置别名到指标名映射。
# 一对一映射反向用于回放 model_id；多个别名指向同名模型时阻止自动回放，避免目标不明确。
# 示例：VITE_MODEL_METRICS_MAP='{"qwen-service":"Qwen/Qwen3-32B"}'
VITE_MODEL_METRICS_MAP='{}'
# DeepSeek 默认会把 proxy/prefill/decode 的所有 engine 混合平均并展示一行；可按模型名片段覆盖。
VITE_MIXED_LATENCY_ROLE_MODELS=deepseek
# 可选：覆盖五张卡片的 vLLM 指标名。TTFT/E2E/ITL/QT 使用 sum、count 两个字段。
# ITL 默认使用 inter_token_latency_seconds，QT 使用 request_queue_time_seconds。
# TPOT 使用 decodeSum、generationTokensSum、generationTokensCount 三个字段，减法位于分母。
# 示例：VITE_PROMETHEUS_METRIC_NAMES='{"ttft":{"sum":"vllm:time_to_first_token_seconds_sum","count":"vllm:time_to_first_token_seconds_count"}}'
VITE_PROMETHEUS_METRIC_NAMES='{}'
# 这些是建议的回放接口，需与后端确认。
# VITE_ 变量会进入前端产物，这里仅配置路径；认证值在页面连接设置中输入。
VITE_REPLAY_CREATE_PATH=/api/replays
VITE_REPLAY_STATUS_PATH=/api/replays/{id}
